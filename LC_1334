class Solution {
public:
    int findTheCity(int n, vector<vector<int>>& edges,
                    int distanceThreshold) {

        int INF = 1000000;

        vector<vector<int>> dist(n, vector<int>(n, INF));

        // If a city is 0 away from itself
        for (int i = 0; i < n; i++) {
            dist[i][i] = 0;
        }

        // Add the directional roads
        for (int i = 0; i < edges.size(); i++) {
            int u = edges[i][0];
            int v = edges[i][1];
            int w = edges[i][2];

            dist[u][v] = w;
            dist[v][u] = w;
        }

        // Floyd-Warshall to find shortest path 
        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    dist[i][j] = min(
                        dist[i][j],
                        dist[i][k] + dist[k][j]
                    );
                }
            }
        }

        //Count reachable neighbors
        int answer = -1;
        int minCount = n;

        for (int i = 0; i < n; i++) {
            int count = 0;

            for (int j = 0; j < n; j++) {
                if (i != j && dist[i][j] <= distanceThreshold) {
                    count++; //compares cities and see if they have a similiar distance threshold 
                }
            }

            if (count <= minCount) 
            {
                minCount = count;
                answer = i; 
                //if cities have the same count the greater city wins
            }
        }

        return answer;
    }
};
