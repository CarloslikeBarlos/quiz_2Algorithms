class Solution 
{
public:
    int minCostConnectPoints(vector<vector<int>>& points) 
    {
        int n = points.size();
        vector<vector<int>> edges;
        for (int i = 0; i < n; ++i) 
        {
            for (int j = i + 1; j < n; ++j) 
            {
                int distance= abs(points[i][0] - points[j][0]) + abs(points[i][1] - points[j][1]);
                edges.push_back({distance, i, j});
            }  
        }
        sort(edges.begin(), edges.end());

        vector<int>parent(n);
        for(int i = 0; i < n; i++)
        {
            parent[i] = i;
        }
        int totalCost= 0;
        int count= 0;
        for(int i=0;i<edges.size();i++)
        {
            int dist=edges[i][0];
            int x= edges[i][1];
            int y= edges[i][2];
            while (parent[x]!=x)
            {
                x=parent[x];
            }
            while (parent[y]!=y)
            {
                y=parent[y];
            }
            if(x!=y)
            {
                parent[x]=y;
                totalCost += dist;
                count+=1;
            }
            if(count==n-1)
            {
                break;
            }
        }
        return totalCost;
    }
};   

